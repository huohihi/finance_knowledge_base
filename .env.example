# =============================================================
# 金融知识库 finance_knowledge_base - 环境变量模板
# 复制为 .env 后按实际环境填写
# =============================================================

# ==================== 模型源与缓存 ====================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache

# ==================== LLM (OpenAI 兼容接口) ====================
OPENAI_API_KEY=your_api_key
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# ==================== BGE 嵌入 / 重排模型 ====================
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_LARGE=D:/ai_models/modelscope_cache/models/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ==================== Milvus 向量库 ====================
MILVUS_URL=http://192.168.10.150:19530
# 金融知识切片集合（正文）
CHUNKS_COLLECTION=fin_chunks_v1
# 金融实体/产品集合（用于查询前对齐确认）
ENTITY_COLLECTION=fin_entities_v1

# ==================== MongoDB（对话历史）====================
MONGO_URL=mongodb://192.168.10.150:27017
MONGO_DB_NAME=fin_kb

# ==================== MinIO 对象存储 ====================
MINIO_ENDPOINT=192.168.10.150:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=finance-knowledge-files

# ==================== MCP 联网搜索（可选）====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
DASHSCOPE_API_KEY=your_dashscope_key
